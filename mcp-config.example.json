{
  "mcpServers": {
    "magnum-go": {
      "command": "ssh",
      "args": [
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "StrictHostKeyChecking=yes",
        "<user>@server-host",
        "/opt/magnum-go-mcp/.venv/bin/python",
        "/opt/magnum-go-mcp/magnum_mcp.py"
      ],
      "env": {
        "PROGRAMDATA": "C:\\ProgramData",
        "ALLUSERSPROFILE": "C:\\ProgramData"
      }
    }
  }
}
